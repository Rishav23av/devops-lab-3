pipeline {
    agent any
    options {
        skipDefaultCheckout(true)
        disableConcurrentBuilds()
    }
    triggers { pollSCM('H/5 * * * *') }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Test') {
            steps {
                sh 'python3 -m venv .venv'
                sh '.venv/bin/python -m pip install -r requirements-dev.txt -r security/requirements.txt'
                sh 'mkdir -p test-results'
                sh '.venv/bin/python -m pytest tests/test_app.py -v --junitxml=test-results/pytest.xml'
            }
            post { always { junit 'test-results/pytest.xml' } }
        }
        stage('Dependency audit') {
            steps { sh '.venv/bin/pip-audit -r app/requirements.txt' }
        }
        stage('Static analysis') {
            steps { sh '.venv/bin/bandit -r app/ -q' }
        }
        stage('Build image') {
            steps { sh 'docker build -f docker/Dockerfile -t devops-lab3-app:$BUILD_NUMBER .' }
        }
        stage('Image scan') {
            steps {
                sh 'trivy image --exit-code 1 --severity HIGH,CRITICAL --no-progress devops-lab3-app:$BUILD_NUMBER'
            }
        }
    }
    post {
        success { echo 'Tests and security checks passed' }
        failure { echo 'Build failed; check the tests or scan findings' }
    }
}
