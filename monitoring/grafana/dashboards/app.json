{
  "title": "Rishav - DevOps Lab 3",
  "uid": "rishav-lab3",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1, "title": "Requests per second", "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "lab3-prometheus"},
      "targets": [{"refId": "A", "expr": "sum by (route) (rate(lab3_http_requests_total[1m]))", "legendFormat": "{{route}}"}]
    },
    {
      "id": 2, "title": "App available", "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "lab3-prometheus"},
      "targets": [{"refId": "A", "expr": "up{job=\"lab3-app\"}"}]
    },
    {
      "id": 3, "title": "Total requests", "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 8},
      "datasource": {"type": "prometheus", "uid": "lab3-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(lab3_http_requests_total)"}]
    },
    {
      "id": 4, "title": "95th percentile response time (seconds)", "type": "timeseries",
      "gridPos": {"x": 0, "y": 8, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "lab3-prometheus"},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, route) (rate(lab3_http_request_duration_seconds_bucket[1m])))", "legendFormat": "{{route}}"}]
    }
  ]
}
